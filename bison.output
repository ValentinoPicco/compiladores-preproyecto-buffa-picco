Grammar

    0 $accept: P $end

    1 P: TRET Main '(' ')' '{' D S '}'

    2 E: E '+' E
    3  | E '*' E
    4  | '(' E ')'
    5  | Nro
    6  | Not E
    7  | E And E
    8  | E Or E
    9  | True
   10  | False
   11  | Id
   12  | Id '=' E

   13 RET: Return E
   14    | Return

   15 TRET: Int
   16     | Bool
   17     | Void

   18 TVAR: Int
   19     | Bool

   20 DEC: TVAR Id

   21 D: D DEC ';'
   22  | ε

   23 S: S E ';'
   24  | S RET ';'
   25  | ε


